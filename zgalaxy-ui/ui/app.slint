// ZGALAXY Desktop Client — Gamer-first, Windows 11 inspired (spec §8).
// Unified Single-Window Architecture: ONE top-level OS Window with internal page views.

import { Button, LineEdit, VerticalBox, HorizontalBox, CheckBox, ScrollView, ListView, Palette } from "std-widgets.slint";

export global AppTrayState {
    in-out property <image> icon: @image-url("assets/app-icon-gold.png");
}

export global Tokens {
    // spacing scale 4/8/12/16/24
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-6: 24px;
    // typography scale
    out property <length> font-hero: 22px;
    out property <length> font-title: 20px;
    out property <length> font-section: 16px;
    out property <length> font-emphasis: 15px;
    out property <length> font-body: 14px;
    out property <length> font-small: 13px;
    out property <length> font-secondary: 12px;
    out property <length> font-caption: 11px;
    // geometry
    out property <length> radius: 8px;
    out property <length> radius-sm: 6px;
    out property <length> card-height: 64px;
    out property <length> nav-height: 36px;
    out property <length> nav-width: 140px;
    out property <length> pill-height: 28px;
    out property <length> accent-bar: 3px;
    // control geometry
    out property <length> ctrl-h: 36px;
    out property <length> btn-min-w: 96px;
    out property <length> btn-sm-w: 72px;
    // semantic colors
    out property <color> success: #1a7f37;
    out property <color> warning: #b8860b;
    out property <color> error: #c62828;
    // window dimensions
    out property <length> win-w: 480px;
    out property <length> win-main-h: 580px;
}

export struct NetworkInfo {
    name: string,
    nwid: string,
    address: string,
    state-label: string,
    state-emoji: string,
    state-kind: string,
    ready: bool,
}

export struct PeerInfo {
    address: string,
    role: string,
    latency: string,
    active: bool,
}

component SecondaryText inherits Text {
    color: Palette.foreground.with-alpha(0.55);
}

component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    spacing: Tokens.sp-2;
    Text {
        text: root.title;
        font-size: Tokens.font-caption;
        font-weight: 700;
        color: Palette.foreground.with-alpha(0.45);
        vertical-alignment: center;
    }
    Text {
        text: root.count;
        font-size: Tokens.font-caption;
        font-weight: 700;
        color: Palette.accent-background;
        vertical-alignment: center;
    }
    Rectangle {
        height: 1px;
        background: Palette.foreground.with-alpha(0.08);
        horizontal-stretch: 1;
    }
}

component StatusPill inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <string> kind; // success | warning | error | neutral
    property <color> tint:
        kind == "success" ? Tokens.success
        : kind == "warning" ? Tokens.warning
        : kind == "error" ? Tokens.error
        : Palette.foreground.with-alpha(0.45);

    height: Tokens.pill-height;
    border-radius: self.height / 2;
    background: tint.with-alpha(0.13);
    border-width: 1px;
    border-color: tint.with-alpha(0.35);

    HorizontalLayout {
        padding-left: Tokens.sp-3;
        padding-right: Tokens.sp-3;
        spacing: Tokens.sp-1;
        alignment: center;
        Text {
            text: root.emoji;
            font-size: Tokens.font-small;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: Tokens.font-small;
            font-weight: 600;
            color: tint;
            vertical-alignment: center;
        }
    }
}

component NetworkCard inherits Rectangle {
    in property <string> c-name;
    in property <string> c-nwid;
    in property <string> c-address;
    in property <string> c-state-label;
    in property <string> c-state-emoji;
    in property <string> c-state-kind;
    in property <bool> c-ready;
    callback card-clicked();
    callback ctx-open();
    callback ctx-copy-address();
    callback ctx-copy-nwid();
    callback ctx-disconnect();

    height: Tokens.card-height;
    border-radius: Tokens.radius;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.08);
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: Tokens.accent-bar;
        height: 100%;
        background: root.c-state-kind == "success" ? Tokens.success
            : root.c-state-kind == "error" ? Tokens.error
            : root.c-state-kind == "warning" ? Tokens.warning
            : Palette.foreground.with-alpha(0.25);
    }

    ta := TouchArea {
        clicked => { root.card-clicked(); }
    }

    background: ta.has-hover ? Palette.alternate-background.brighter(0.06) : Palette.alternate-background;

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Open details";
                activated => { root.ctx-open(); }
            }
            MenuItem {
                title: "Copy address";
                enabled: root.c-address != "";
                activated => { root.ctx-copy-address(); }
            }
            MenuItem {
                title: "Copy network ID";
                activated => { root.ctx-copy-nwid(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Disconnect";
                activated => { root.ctx-disconnect(); }
            }
        }
    }

    VerticalLayout {
        padding: Tokens.sp-3;
        spacing: Tokens.sp-1;
        HorizontalLayout {
            spacing: Tokens.sp-2;
            Text {
                text: root.c-state-emoji + "  " + root.c-name;
                font-size: Tokens.font-emphasis;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.c-state-label;
                font-size: Tokens.font-small;
                color: root.c-ready ? Tokens.success : (Palette.foreground.with-alpha(0.55));
                vertical-alignment: center;
            }
        }
        SecondaryText {
            text: root.c-nwid;
            font-size: Tokens.font-secondary;
        }
    }
}

component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: Tokens.nav-height;
    border-radius: Tokens.radius-sm;
    background: root.selected ? Palette.alternate-background : (ta.has-hover ? Palette.alternate-background.with-alpha(0.5) : transparent);

    ta := TouchArea {
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: Tokens.sp-3;
        padding-right: Tokens.sp-3;
        spacing: Tokens.sp-2;
        Text {
            text: root.icon;
            font-size: Tokens.font-body;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: Tokens.font-small;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
}

// ---------------------------------------------------------------------------
// System Tray Icon
// ---------------------------------------------------------------------------
export component AppTray inherits SystemTrayIcon {
    tooltip: "ZGALAXY";
    icon: AppTrayState.icon;
    in-out property <string> status-text: "⚪ Not connected";
    in-out property <[NetworkInfo]> networks;

    callback open-main();
    callback open-join();
    callback open-network(string);
    callback open-prefs();
    callback open-about();
    callback quit-app();

    Menu {
        MenuItem {
            title: root.status-text;
            enabled: false;
        }
        MenuSeparator {}
        MenuItem {
            title: "Open ZGALAXY";
            activated => { root.open-main(); }
        }
        MenuItem {
            title: "Join Network...";
            activated => { root.open-join(); }
        }
        MenuSeparator {}
        Menu {
            title: "Your Networks";
            if root.networks.length == 0 : MenuItem {
                title: "No networks yet";
                enabled: false;
            }
            for net in root.networks : MenuItem {
                title: net.state-emoji + " " + net.name;
                activated => { root.open-network(net.nwid); }
            }
        }
        MenuSeparator {}
        MenuItem {
            title: "Preferences...";
            activated => { root.open-prefs(); }
        }
        MenuItem {
            title: "About ZGALAXY";
            activated => { root.open-about(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit ZGALAXY";
            activated => { root.quit-app(); }
        }
    }
}

// ---------------------------------------------------------------------------
// UNIFIED MAIN WINDOW (The ONE and ONLY top-level OS Window)
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: root.current-view == "main" ? "ZGALAXY — Networks"
        : root.current-view == "details" ? "ZGALAXY — Network Details"
        : root.current-view == "advanced" ? "ZGALAXY — Advanced Settings"
        : root.current-view == "preferences" ? "ZGALAXY — Preferences"
        : "ZGALAXY — About";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-main-h;

    // View Routing: "main" | "details" | "advanced" | "preferences" | "about"
    in-out property <string> current-view: "main";
    in-out property <bool> show-join-modal: false;

    // Node & Service State
    in-out property <string> node-address: "…";
    in-out property <string> service-state: "Starting";
    in-out property <string> status-line: "Checking service…";
    in-out property <string> status-emoji: "⚪";
    in-out property <string> status-kind: "neutral";
    in-out property <bool> service-ok: true;
    in-out property <[NetworkInfo]> networks;
    in-out property <string> app-version: "";

    // Join Modal State
    in-out property <string> join-input: "";
    in-out property <bool> join-busy: false;
    in-out property <string> join-error-text: "";

    // Network Details State
    in-out property <string> d-nwid: "";
    in-out property <string> d-name: "";
    in-out property <string> d-state-emoji: "🟠";
    in-out property <string> d-state-label: "";
    in-out property <string> d-state-kind: "warning";
    in-out property <string> d-address: "";
    in-out property <bool> d-connected: false;

    // Advanced Window State
    in-out property <string> a-name: "";
    in-out property <string> a-nwid: "";
    in-out property <string> a-state-emoji: "🟠";
    in-out property <string> a-state-label: "";
    in-out property <string> a-address: "";
    in-out property <string> a-device: "";
    in-out property <string> a-mac: "";
    in-out property <string> a-type: "";
    in-out property <string> a-routes: "—";
    in-out property <string> a-dns: "—";
    in-out property <bool> a-allow-managed: false;
    in-out property <bool> a-allow-global: false;
    in-out property <bool> a-allow-default: false;
    in-out property <bool> a-allow-dns: false;

    // Preferences State
    in-out property <int> prefs-page: 0;
    in-out property <bool> p-start-with-system: false;
    in-out property <bool> p-start-background: false;
    in-out property <bool> p-show-tray: true;
    in-out property <bool> p-notify-status: true;
    in-out property <string> adv-endpoint: "…";
    in-out property <string> adv-service: "…";
    in-out property <string> about-node-id: "";
    in-out property <[PeerInfo]> diag-peers;

    // Callbacks
    callback open-join();
    callback close-join();
    callback request-join(string);
    callback open-details(string);
    callback open-advanced();
    callback back-to-main();
    callback back-to-details();
    callback open-prefs();
    callback open-about();
    callback retry();
    callback copy-text(string);
    callback leave-network(string);
    callback disconnect-current();
    callback advanced-flags-changed();
    callback prefs-changed();

    // Root Key Listener for ESC
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show-join-modal) {
                    root.show-join-modal = false;
                    return accept;
                }
                if (root.current-view == "advanced") {
                    root.current-view = "details";
                    return accept;
                }
                if (root.current-view != "main") {
                    root.current-view = "main";
                    return accept;
                }
            }
            reject
        }
    }

    // Main Layout
    VerticalLayout {
        padding: Tokens.sp-4;
        spacing: Tokens.sp-3;

        // Top Navigation & Actions Bar
        HorizontalLayout {
            spacing: Tokens.sp-2;
            min-height: Tokens.ctrl-h;

            if root.current-view == "main" : HorizontalLayout {
                spacing: Tokens.sp-2;
                horizontal-stretch: 1;
                StatusPill {
                    emoji: root.status-emoji;
                    label: root.status-line;
                    kind: root.status-kind;
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.service-ok : Button {
                    text: "Retry";
                    min-height: Tokens.ctrl-h;
                    clicked => { root.retry(); }
                }
                Rectangle {
                    width: Tokens.btn-sm-w;
                    height: Tokens.ctrl-h;
                    border-radius: Tokens.radius-sm;
                    background: join-btn-ta.has-hover
                        ? Palette.accent-background.brighter(0.15)
                        : Palette.accent-background;

                    join-btn-ta := TouchArea {
                        clicked => {
                            root.join-error-text = "";
                            root.join-input = "";
                            root.show-join-modal = true;
                        }
                    }

                    Text {
                        text: "+ Join";
                        color: Palette.accent-foreground;
                        font-size: Tokens.font-small;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Preferences icon button
                Rectangle {
                    width: Tokens.ctrl-h;
                    height: Tokens.ctrl-h;
                    border-radius: Tokens.radius-sm;
                    background: pref-ta.has-hover ? Palette.alternate-background : transparent;
                    pref-ta := TouchArea {
                        clicked => { root.current-view = "preferences"; }
                    }
                    Text {
                        text: "⚙";
                        font-size: Tokens.font-section;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
                // About icon button
                Rectangle {
                    width: Tokens.ctrl-h;
                    height: Tokens.ctrl-h;
                    border-radius: Tokens.radius-sm;
                    background: about-ta.has-hover ? Palette.alternate-background : transparent;
                    about-ta := TouchArea {
                        clicked => { root.current-view = "about"; }
                    }
                    Text {
                        text: "ℹ";
                        font-size: Tokens.font-section;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
            }

            if root.current-view != "main" : HorizontalLayout {
                spacing: Tokens.sp-3;
                horizontal-stretch: 1;
                Button {
                    text: "← Back";
                    min-height: Tokens.ctrl-h;
                    min-width: 80px;
                    clicked => {
                        if (root.current-view == "advanced") {
                            root.current-view = "details";
                        } else {
                            root.current-view = "main";
                        }
                    }
                }
                Text {
                    text: root.current-view == "details" ? root.d-name
                        : root.current-view == "advanced" ? "Advanced Configuration"
                        : root.current-view == "preferences" ? "Preferences"
                        : "About ZGALAXY";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.with-alpha(0.08);
        }

        // ===================================================================
        // View 1: Main Networks List View
        // ===================================================================
        if root.current-view == "main" : VerticalLayout {
            vertical-stretch: 1;
            spacing: Tokens.sp-3;

            if root.networks.length == 0 && root.service-ok : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: Tokens.sp-2;
                Image {
                    source: @image-url("assets/app-icon-gold.png");
                    width: 64px;
                    height: 64px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No networks yet";
                    font-size: Tokens.font-section;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                SecondaryText {
                    text: "Join a network to get started";
                    font-size: Tokens.font-small;
                    horizontal-alignment: center;
                }
                Button {
                    text: "Join a Network…";
                    min-height: Tokens.ctrl-h;
                    min-width: Tokens.btn-min-w;
                    clicked => {
                        root.join-error-text = "";
                        root.join-input = "";
                        root.show-join-modal = true;
                    }
                }
            }

            if root.networks.length > 0 : VerticalLayout {
                vertical-stretch: 1;
                spacing: Tokens.sp-2;
                SectionHeader {
                    title: "YOUR NETWORKS";
                    count: root.networks.length;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Tokens.sp-2;
                        for net in root.networks : NetworkCard {
                            c-name: net.name;
                            c-nwid: net.nwid;
                            c-address: net.address == "no address yet" ? "" : net.address;
                            c-state-label: net.state-label;
                            c-state-emoji: net.state-emoji;
                            c-state-kind: net.state-kind;
                            c-ready: net.ready;
                            card-clicked => { root.open-details(net.nwid); }
                            ctx-open => { root.open-details(net.nwid); }
                            ctx-copy-address => { root.copy-text(net.address); }
                            ctx-copy-nwid => { root.copy-text(net.nwid); }
                            ctx-disconnect => { root.leave-network(net.nwid); }
                        }
                    }
                }
            }
        }

        // ===================================================================
        // View 2: Network Details View
        // ===================================================================
        if root.current-view == "details" : VerticalLayout {
            vertical-stretch: 1;
            padding-top: Tokens.sp-3;
            spacing: Tokens.sp-4;

            HorizontalLayout {
                alignment: center;
                StatusPill {
                    emoji: root.d-state-emoji;
                    label: root.d-state-label;
                    kind: root.d-state-kind;
                }
            }

            Text {
                text: root.d-name;
                font-size: Tokens.font-title;
                font-weight: 700;
                horizontal-alignment: center;
                color: Palette.foreground;
            }

            Rectangle {
                border-radius: Tokens.radius;
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.foreground.with-alpha(0.08);

                VerticalLayout {
                    padding: Tokens.sp-4;
                    spacing: Tokens.sp-3;

                    VerticalLayout {
                        spacing: Tokens.sp-1;
                        SecondaryText {
                            text: "Your IP Address";
                            font-size: Tokens.font-secondary;
                        }
                        HorizontalLayout {
                            padding: 0;
                            spacing: Tokens.sp-2;
                            Text {
                                text: root.d-address != "" ? root.d-address : "Waiting for IP assignment…";
                                font-size: Tokens.font-emphasis;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Copy";
                                min-height: Tokens.ctrl-h;
                                min-width: Tokens.btn-sm-w;
                                enabled: root.d-address != "";
                                clicked => { root.copy-text(root.d-address); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.with-alpha(0.1);
                    }

                    VerticalLayout {
                        spacing: Tokens.sp-1;
                        SecondaryText {
                            text: "Network ID";
                            font-size: Tokens.font-secondary;
                        }
                        HorizontalLayout {
                            padding: 0;
                            spacing: Tokens.sp-2;
                            Text {
                                text: root.d-nwid;
                                font-size: Tokens.font-body;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Copy";
                                min-height: Tokens.ctrl-h;
                                min-width: Tokens.btn-sm-w;
                                clicked => { root.copy-text(root.d-nwid); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.with-alpha(0.1);
                    }

                    VerticalLayout {
                        spacing: Tokens.sp-1;
                        SecondaryText {
                            text: "Connection State";
                            font-size: Tokens.font-secondary;
                        }
                        Text {
                            text: root.d-connected ? "● Connected & Ready" : "○ Waiting for authorization / offline";
                            font-size: Tokens.font-body;
                            color: root.d-connected ? Tokens.success : Palette.foreground.with-alpha(0.55);
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: Tokens.sp-3;
                alignment: end;
                Button {
                    text: "Advanced Settings…";
                    min-height: Tokens.ctrl-h;
                    min-width: Tokens.btn-min-w;
                    clicked => { root.open-advanced(); }
                }
                Button {
                    text: "Disconnect";
                    min-height: Tokens.ctrl-h;
                    min-width: Tokens.btn-min-w;
                    clicked => { root.disconnect-current(); }
                }
            }
        }

        // ===================================================================
        // View 3: Advanced Configuration View
        // ===================================================================
        if root.current-view == "advanced" : VerticalLayout {
            vertical-stretch: 1;
            spacing: Tokens.sp-2;

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: Tokens.sp-3;
                    padding-right: Tokens.sp-2;

                    SectionHeader { title: "NETWORK INFO"; count: ""; }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "Network ID"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-nwid; font-size: Tokens.font-secondary; }
                    }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "Device Name"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-device != "" ? root.a-device : "zt-dev"; font-size: Tokens.font-secondary; }
                    }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "MAC Address"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-mac; font-size: Tokens.font-secondary; }
                    }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "Type"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-type; font-size: Tokens.font-secondary; }
                    }

                    SectionHeader { title: "ADDRESSES & ROUTES"; count: ""; }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "Managed IP"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-address != "" ? root.a-address : "—"; font-size: Tokens.font-secondary; }
                    }

                    HorizontalLayout {
                        padding: 0;
                        Text { text: "Routes"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.a-routes; font-size: Tokens.font-secondary; }
                    }

                    SectionHeader { title: "POLICIES & PERMISSIONS"; count: ""; }

                    CheckBox {
                        text: "Allow Managed IPs";
                        checked <=> root.a-allow-managed;
                        toggled => { root.advanced-flags-changed(); }
                    }
                    CheckBox {
                        text: "Allow Global IPs";
                        checked <=> root.a-allow-global;
                        toggled => { root.advanced-flags-changed(); }
                    }
                    CheckBox {
                        text: "Allow Default Route Override";
                        checked <=> root.a-allow-default;
                        toggled => { root.advanced-flags-changed(); }
                    }
                    CheckBox {
                        text: "Allow DNS Server Configuration";
                        checked <=> root.a-allow-dns;
                        toggled => { root.advanced-flags-changed(); }
                    }
                }
            }
        }

        // ===================================================================
        // View 4: Preferences View
        // ===================================================================
        if root.current-view == "preferences" : HorizontalLayout {
            vertical-stretch: 1;
            spacing: Tokens.sp-3;

            // Side tabs
            VerticalLayout {
                width: Tokens.nav-width;
                spacing: Tokens.sp-1;
                NavRow { icon: "⚙"; label: "General"; selected: root.prefs-page == 0; activated => { root.prefs-page = 0; } }
                NavRow { icon: "🔔"; label: "Notifications"; selected: root.prefs-page == 1; activated => { root.prefs-page = 1; } }
                NavRow { icon: "🛠"; label: "Advanced"; selected: root.prefs-page == 2; activated => { root.prefs-page = 2; } }
                NavRow { icon: "📊"; label: "Diagnostics"; selected: root.prefs-page == 3; activated => { root.prefs-page = 3; } }
                Rectangle { vertical-stretch: 1; }
            }

            Rectangle {
                width: 1px;
                background: Palette.foreground.with-alpha(0.1);
            }

            // Tab contents
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Tokens.sp-3;

                if root.prefs-page == 0 : VerticalLayout {
                    spacing: Tokens.sp-3;
                    Text { text: "General Settings"; font-size: Tokens.font-section; font-weight: 700; }
                    CheckBox {
                        text: "Start with system";
                        checked <=> root.p-start-with-system;
                        toggled => { root.prefs-changed(); }
                    }
                    CheckBox {
                        text: "Start minimized in background";
                        checked <=> root.p-start-background;
                        toggled => { root.prefs-changed(); }
                    }
                    CheckBox {
                        text: "Show tray icon next to clock";
                        checked <=> root.p-show-tray;
                        toggled => { root.prefs-changed(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.prefs-page == 1 : VerticalLayout {
                    spacing: Tokens.sp-3;
                    Text { text: "Notification Settings"; font-size: Tokens.font-section; font-weight: 700; }
                    CheckBox {
                        text: "Show status change notifications";
                        checked <=> root.p-notify-status;
                        toggled => { root.prefs-changed(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.prefs-page == 2 : VerticalLayout {
                    spacing: Tokens.sp-3;
                    Text { text: "Service Details"; font-size: Tokens.font-section; font-weight: 700; }
                    HorizontalLayout {
                        Text { text: "Local Daemon"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.adv-endpoint; font-size: Tokens.font-secondary; }
                    }
                    HorizontalLayout {
                        Text { text: "Service Health"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.adv-service; font-size: Tokens.font-secondary; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.prefs-page == 3 : VerticalLayout {
                    spacing: Tokens.sp-2;
                    Text { text: "Connected Peers"; font-size: Tokens.font-section; font-weight: 700; }
                    if root.diag-peers.length == 0 : SecondaryText {
                        text: "No active peers";
                        font-size: Tokens.font-secondary;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: Tokens.sp-1;
                            for p in root.diag-peers : HorizontalLayout {
                                Text {
                                    text: (p.active ? "● " : "○ ") + p.address;
                                    font-size: Tokens.font-secondary;
                                    color: p.active ? Palette.foreground : Palette.foreground.with-alpha(0.5);
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: p.role; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                                Text { text: "  " + p.latency; font-size: Tokens.font-secondary; }
                            }
                        }
                    }
                }
            }
        }

        // ===================================================================
        // View 5: About View
        // ===================================================================
        if root.current-view == "about" : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Tokens.sp-2;

            Image {
                source: @image-url("assets/app-icon-gold.png");
                width: 64px;
                height: 64px;
                horizontal-alignment: center;
            }
            Text {
                text: "ZGALAXY";
                font-size: 26px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            SecondaryText {
                text: "Desktop client · v" + root.app-version;
                font-size: Tokens.font-secondary;
                horizontal-alignment: center;
            }
            Text {
                text: "Node ID: " + root.about-node-id;
                font-size: Tokens.font-secondary;
                horizontal-alignment: center;
            }
            SecondaryText {
                text: "Pure Rust Next-Gen P2P Mesh Virtual Network";
                font-size: Tokens.font-caption;
                horizontal-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.with-alpha(0.08);
        }

        // Footer Bar
        HorizontalLayout {
            spacing: Tokens.sp-2;
            Text {
                text: "Node " + root.node-address;
                font-size: Tokens.font-secondary;
                color: Palette.accent-background;
                vertical-alignment: center;
            }
            SecondaryText {
                text: "· " + root.service-state;
                font-size: Tokens.font-secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            SecondaryText {
                text: "v" + root.app-version;
                font-size: Tokens.font-secondary;
                vertical-alignment: center;
            }
        }
    }

    // =======================================================================
    // MODAL OVERLAY: Join Network Dialog
    // =======================================================================
    if root.show-join-modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000088;

        // Click on dark backdrop to dismiss
        modal-backdrop-ta := TouchArea {
            clicked => {
                root.show-join-modal = false;
            }
        }

        // Dialog Card
        Rectangle {
            width: Tokens.win-w - 40px;
            height: 210px;
            border-radius: Tokens.radius;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.15);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            VerticalBox {
                padding: Tokens.sp-4;
                spacing: Tokens.sp-3;

                HorizontalLayout {
                    Text {
                        text: "Join a Network";
                        font-size: Tokens.font-section;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: close-modal-ta.has-hover ? Palette.alternate-background : transparent;
                        close-modal-ta := TouchArea {
                            clicked => { root.show-join-modal = false; }
                        }
                        Text {
                            text: "✕";
                            font-size: Tokens.font-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                joinModalField := LineEdit {
                    placeholder-text: "Enter 16-hex network ID (e.g. ef313fb5c9bc842c)";
                    text <=> root.join-input;
                    enabled: !root.join-busy;
                    min-height: Tokens.ctrl-h;
                    accepted => {
                        if (root.join-input != "") {
                            root.request-join(root.join-input);
                        }
                    }
                }

                if root.join-error-text != "" : Text {
                    text: root.join-error-text;
                    color: Tokens.error;
                    font-size: Tokens.font-secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.sp-2;
                    Button {
                        text: "Cancel";
                        min-height: Tokens.ctrl-h;
                        min-width: Tokens.btn-min-w;
                        clicked => { root.show-join-modal = false; }
                    }
                    Button {
                        text: "Join Network";
                        min-height: Tokens.ctrl-h;
                        min-width: Tokens.btn-min-w;
                        enabled: !root.join-busy && root.join-input != "";
                        clicked => {
                            root.request-join(root.join-input);
                        }
                    }
                }
            }
        }
    }
}
