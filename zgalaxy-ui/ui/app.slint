// ZGALAXY Desktop Client — Gamer-first, Windows 11 inspired (spec §8).
// Windows hold layout only: no network logic, no status wording — labels and
// emoji always arrive from the Rust core (NetworkInfo / OverallState).

import { Button, LineEdit, VerticalBox, HorizontalBox, CheckBox, ScrollView, ListView, Palette } from "std-widgets.slint";

// Tray state is a global because Slint does not expose a setter for the
// builtin SystemTrayIcon.icon `in` property; the binding below feeds it, and
// Rust updates this global when the connection state changes (gold=ready,
// gray=not). Globals on a SystemTrayIcon component are per-instance, which is
// exactly what we want.
export global AppTrayState {
    in-out property <image> icon: @image-url("assets/app-icon-gold.png");
}

// Design tokens (spec §19): the single source of truth for spacing,
// typography, radii, control sizes and window dimensions. Every literal in
// this file derives from here so the whole app stays on one visual scale.
export global Tokens {
    // spacing scale 4/8/12/16/24 (spec §8.3 "نظام ثابت")
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-6: 24px;
    // typography scale
    out property <length> font-hero: 22px;
    out property <length> font-title: 20px;
    out property <length> font-section: 16px;
    out property <length> font-emphasis: 15px;
    out property <length> font-body: 14px;
    out property <length> font-small: 13px;
    out property <length> font-secondary: 12px;
    out property <length> font-caption: 11px;
    // geometry
    out property <length> radius: 8px;
    out property <length> radius-sm: 6px;
    out property <length> card-height: 64px;
    out property <length> nav-height: 36px;
    out property <length> nav-width: 140px;
    out property <length> pill-height: 28px;
    out property <length> accent-bar: 3px;
    // control geometry — one calculated scale for every interactive element
    // (spec §15 comfortable targets; §8.3 fixed spacing system)
    out property <length> ctrl-h: 36px;      // buttons + inputs + nav rows
    out property <length> btn-min-w: 96px;   // primary/secondary actions
    out property <length> btn-sm-w: 72px;    // compact actions (Copy)
    // semantic colors (spec §8.4)
    out property <color> success: #1a7f37;
    out property <color> warning: #b8860b;
    out property <color> error: #c62828;
    // window dimensions: ONE unified width across the app; each window's
    // height follows its own content (spec §8.3 — consistent gutters, no
    // arbitrary uniformity that fights the content).
    out property <length> win-w: 460px;
    // content-driven heights
    out property <length> win-main-h: 560px;
    out property <length> win-join-h: 200px;
    out property <length> win-details-h: 480px;
    out property <length> win-advanced-h: 640px;
    out property <length> win-prefs-h: 440px;
    out property <length> win-about-h: 320px;
}

export struct NetworkInfo {
    name: string,
    nwid: string,
    address: string,
    state-label: string,
    state-emoji: string,
    state-kind: string,
    ready: bool,
}

export struct PeerInfo {
    address: string,
    role: string,
    latency: string,
    active: bool,
}

component SecondaryText inherits Text {
    color: Palette.foreground.with-alpha(0.55);
}

component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    spacing: Tokens.sp-2;
    Text {
        text: root.title;
        font-size: Tokens.font-caption;
        font-weight: 700;
        color: Palette.foreground.with-alpha(0.45);
        vertical-alignment: center;
    }
    Text {
        text: root.count;
        font-size: Tokens.font-caption;
        font-weight: 700;
        color: Palette.accent-background;
        vertical-alignment: center;
    }
    Rectangle {
        height: 1px;
        background: Palette.foreground.with-alpha(0.08);
        horizontal-stretch: 1;
    }
}

// Rounded status badge: emoji + human label on a soft tint of the state
// color. Color never carries meaning alone — emoji and text ride along (§15).
component StatusPill inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <string> kind; // success | warning | error | neutral
    property <color> tint:
        kind == "success" ? Tokens.success
        : kind == "warning" ? Tokens.warning
        : kind == "error" ? Tokens.error
        : Palette.foreground.with-alpha(0.45);

    height: Tokens.pill-height;
    border-radius: self.height / 2;
    background: tint.with-alpha(0.13);
    border-width: 1px;
    border-color: tint.with-alpha(0.35);

    HorizontalLayout {
        padding-left: Tokens.sp-3;
        padding-right: Tokens.sp-3;
        spacing: Tokens.sp-1;
        alignment: center;
        Text {
            text: root.emoji;
            font-size: Tokens.font-small;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: Tokens.font-small;
            font-weight: 600;
            color: tint;
            vertical-alignment: center;
        }
    }
}

// One network row in the Networks window (spec §6.4): name + status on the
// first line, network id small underneath. No buttons — the whole card is
// one click target that opens Network Details.
component NetworkCard inherits Rectangle {
    in property <string> c-name;
    in property <string> c-nwid;
    in property <string> c-address;
    in property <string> c-state-label;
    in property <string> c-state-emoji;
    in property <string> c-state-kind; // success | warning | error | neutral
    in property <bool> c-ready;
    callback card-clicked();
    callback ctx-open();
    callback ctx-copy-address();
    callback ctx-copy-nwid();
    callback ctx-disconnect();

    height: Tokens.card-height;
    border-radius: Tokens.radius;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.08);
    clip: true;

    // state accent bar — redundant state signal (color + emoji + text §15)
    Rectangle {
        x: 0;
        y: 0;
        width: Tokens.accent-bar;
        height: 100%;
        background: root.c-state-kind == "success" ? Tokens.success
            : root.c-state-kind == "error" ? Tokens.error
            : root.c-state-kind == "warning" ? Tokens.warning
            : Palette.foreground.with-alpha(0.25);
    }

    ta := TouchArea {
        clicked => { root.card-clicked(); }
    }

    background: ta.has-hover ? Palette.alternate-background.brighter(0.06) : Palette.alternate-background;

    // Right-click actions (spec §6.4/§3.2 reference model): quick operations
    // without leaving the list.
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Open details";
                activated => { root.ctx-open(); }
            }
            MenuItem {
                title: "Copy address";
                enabled: root.c-address != "";
                activated => { root.ctx-copy-address(); }
            }
            MenuItem {
                title: "Copy network ID";
                activated => { root.ctx-copy-nwid(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Disconnect";
                activated => { root.ctx-disconnect(); }
            }
        }
    }

    VerticalLayout {
        padding: Tokens.sp-3;
        spacing: Tokens.sp-1;
        HorizontalLayout {
            spacing: Tokens.sp-2;
            Text {
                text: root.c-state-emoji + "  " + root.c-name;
                font-size: Tokens.font-emphasis;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.c-state-label;
                font-size: Tokens.font-small;
                color: root.c-ready ? Tokens.success : (Palette.foreground.with-alpha(0.55));
                vertical-alignment: center;
            }
        }
        SecondaryText {
            text: root.c-nwid;
            font-size: Tokens.font-secondary;
        }
    }
}

// ---------------------------------------------------------------------------
// System Tray — the primary interface (spec §6.1/§9)
// ---------------------------------------------------------------------------
export component AppTray inherits SystemTrayIcon {
    // icon: deliberately NOT bound here — assigned from Rust so it can follow
    // connection state (gold when ready, gray otherwise). Slint creates the
    // tray icon once a non-empty image is set.
    tooltip: "ZGALAXY";

    icon: AppTrayState.icon;
    in-out property <string> status-text: "⚪ Not connected";
    in-out property <[NetworkInfo]> networks;

    callback open-main();
    callback open-join();
    callback open-network(string);
    callback open-prefs();
    callback open-about();
    callback quit-app();

    Menu {
        MenuItem {
            title: root.status-text;
            enabled: false;
        }
        MenuSeparator {}
        MenuItem {
            title: "Open ZGALAXY";
            activated => { root.open-main(); }
        }
        MenuItem {
            title: "Join Network...";
            activated => { root.open-join(); }
        }
        MenuSeparator {}
        Menu {
            title: "Your Networks";
            if root.networks.length == 0 : MenuItem {
                title: "No networks yet";
                enabled: false;
            }
            for net in root.networks : MenuItem {
                title: net.state-emoji + " " + net.name;
                activated => { root.open-network(net.nwid); }
            }
        }
        MenuSeparator {}
        MenuItem {
            title: "Settings";
            activated => { root.open-prefs(); }
        }
        MenuItem {
            title: "About";
            activated => { root.open-about(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit-app(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Networks window (spec §6.4): calm list, click a card for details.
// ---------------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "ZGALAXY — Networks";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-main-h;

    in-out property <string> node-address: "…";
    in-out property <string> service-state: "Starting";
    in-out property <string> status-line: "Checking service…";
    in-out property <string> status-emoji: "⚪";
    in-out property <string> status-kind: "neutral";
    in-out property <bool> service-ok: true;
    in-out property <[NetworkInfo]> networks;
    in-out property <string> app-version: "";

    callback open-details(string);
    callback open-join();
    callback retry();
    callback copy-text(string);
    callback leave-network(string);

    VerticalBox {
        padding: Tokens.sp-4;
        spacing: Tokens.sp-3;

        HorizontalLayout {
            spacing: Tokens.sp-2;
            StatusPill {
                emoji: root.status-emoji;
                label: root.status-line;
                kind: root.status-kind;
            }
            Rectangle { horizontal-stretch: 1; }
            if !root.service-ok : Button {
                text: "Retry";
                min-height: Tokens.ctrl-h;
                clicked => { root.retry(); }
            }
            Rectangle {
                width: Tokens.btn-sm-w;
                height: Tokens.ctrl-h;
                border-radius: Tokens.radius-sm;
                background: join-btn-ta.has-hover
                    ? Palette.accent-background.brighter(0.15)
                    : Palette.accent-background;

                join-btn-ta := TouchArea {
                    clicked => { root.open-join(); }
                }

                Text {
                    text: "Join";
                    color: Palette.accent-foreground;
                    font-size: Tokens.font-small;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.with-alpha(0.08);
        }

        if root.networks.length == 0 && root.service-ok : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: Tokens.sp-2;
            Image {
                source: @image-url("assets/app-icon-gold.png");
                width: 64px;
                height: 64px;
                horizontal-alignment: center;
            }
            Text {
                text: "No networks yet";
                font-size: Tokens.font-section;
                font-weight: 600;
                horizontal-alignment: center;
                color: Palette.foreground;
            }
            SecondaryText {
                text: "Join a network to get started";
                font-size: Tokens.font-small;
                horizontal-alignment: center;
            }
            Button {
                text: "Join a Network…";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                clicked => { root.open-join(); }
            }
        }
        if root.networks.length > 0 : VerticalLayout {
            vertical-stretch: 1;
            spacing: Tokens.sp-2;
            SectionHeader {
                title: "YOUR NETWORKS";
                count: root.networks.length;
            }
            for net in root.networks : NetworkCard {
                c-name: net.name;
                c-nwid: net.nwid;
                c-address: net.address == "no address yet" ? "" : net.address;
                c-state-label: net.state-label;
                c-state-emoji: net.state-emoji;
                c-state-kind: net.state-kind;
                c-ready: net.ready;
                card-clicked => { root.open-details(net.nwid); }
                ctx-open => { root.open-details(net.nwid); }
                ctx-copy-address => { root.copy-text(net.address); }
                ctx-copy-nwid => { root.copy-text(net.nwid); }
                ctx-disconnect => { root.leave-network(net.nwid); }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.with-alpha(0.08);
        }

        // Footer: node identity left, app version right.
        HorizontalLayout {
            spacing: Tokens.sp-2;
            Text {
                text: "Node " + root.node-address;
                font-size: Tokens.font-secondary;
                color: Palette.accent-background;
                vertical-alignment: center;
            }
            SecondaryText {
                text: root.service-state;
                font-size: Tokens.font-secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            SecondaryText {
                text: "v" + root.app-version;
                font-size: Tokens.font-secondary;
                vertical-alignment: center;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Join Network dialog (spec §6.3): one field, two buttons, nothing technical.
// ---------------------------------------------------------------------------
export component JoinDialog inherits Window {
    title: "Join a Network";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-join-h;

    in-out property <string> join-input;
    in-out property <bool> busy: false;
    in-out property <string> error-text: "";

    callback request-join(string);
    callback request-close();

    public function focus-input() {
        joinField.focus();
    }

    esc := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.request-close();
                return accept;
            }
            reject
        }
    }

    VerticalBox {
        padding: Tokens.sp-4;
        spacing: Tokens.sp-3;

        Text {
            text: "Network ID";
            font-size: Tokens.font-secondary;
            color: Palette.foreground.with-alpha(0.55);
        }
        joinField := LineEdit {
            placeholder-text: "Enter network ID";
            text <=> root.join-input;
            enabled: !root.busy;
            min-height: Tokens.ctrl-h;
            accepted => { if (root.join-input != "") { root.request-join(root.join-input); } }
        }
        Text {
            text: root.error-text;
            visible: root.error-text != "";
            color: Tokens.error;
            font-size: Tokens.font-secondary;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            spacing: Tokens.sp-2;
            Button {
                text: "Cancel";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                clicked => { root.request-close(); }
            }
            Button {
                text: "Join";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                enabled: !root.busy && root.join-input != "";
                clicked => { root.request-join(root.join-input); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Main Network window (spec §6.2): the current network at a glance.
// One primary action (Disconnect); Advanced is the only secondary.
// ---------------------------------------------------------------------------
export component NetworkDetailsWindow inherits Window {
    title: "My Network";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-details-h;

    in-out property <string> d-name: "";
    in-out property <string> d-state-emoji: "🟠";
    in-out property <string> d-state-label: "";
    in-out property <string> d-state-kind: "warning";
    in-out property <string> d-address: "";
    in-out property <bool> d-connected: false;

    callback request-close();
    callback copy-address(string);
    callback request-disconnect();
    callback open-advanced();

    VerticalBox {
        padding: Tokens.sp-6;
        spacing: Tokens.sp-3;

        HorizontalLayout {
            alignment: center;
            StatusPill {
                emoji: root.d-state-emoji;
                label: root.d-state-label;
                kind: root.d-state-kind;
            }
        }

        Text {
            text: root.d-name;
            font-size: Tokens.font-title;
            font-weight: 700;
            horizontal-alignment: center;
            color: Palette.foreground;
        }

        // Grouped sheet: address + connection in one card (§8.3 no cards-in-cards
        // overly deep — one level of grouping reads cleanly).
        Rectangle {
            border-radius: Tokens.radius;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: Palette.foreground.with-alpha(0.08);

            VerticalLayout {
                padding: Tokens.sp-4;
                spacing: Tokens.sp-3;

                VerticalLayout {
                    spacing: Tokens.sp-1;
                    SecondaryText {
                        text: "Your address";
                        font-size: Tokens.font-secondary;
                    }
                    HorizontalLayout {
                        padding: 0;
                        spacing: Tokens.sp-2;
                        Text {
                            text: root.d-address;
                            font-size: Tokens.font-emphasis;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Copy";
                            min-height: Tokens.ctrl-h;
                            min-width: Tokens.btn-sm-w;
                            clicked => { root.copy-address(root.d-address); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.foreground.with-alpha(0.1);
                }

                VerticalLayout {
                    spacing: Tokens.sp-1;
                    SecondaryText {
                        text: "Connection";
                        font-size: Tokens.font-secondary;
                    }
                    Text {
                        text: root.d-connected ? "● Connected" : "○ Disconnected";
                        font-size: Tokens.font-body;
                        color: root.d-connected ? Tokens.success : Palette.foreground.with-alpha(0.55);
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Tokens.sp-2;
            alignment: end;
            Button {
                text: "Advanced…";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                clicked => { root.open-advanced(); }
            }
            Button {
                text: "Disconnect";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                enabled: root.d-connected;
                clicked => { root.request-disconnect(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Advanced Network Details (spec §6.5): read-mostly technical layer.
// ---------------------------------------------------------------------------
export component AdvancedWindow inherits Window {
    title: "Network Details — Advanced";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-advanced-h;

    in-out property <string> a-name: "";
    in-out property <string> a-nwid: "";
    in-out property <string> a-state-emoji: "🟠";
    in-out property <string> a-state-label: "";
    in-out property <string> a-address: "";
    in-out property <string> a-device: "";
    in-out property <string> a-mac: "";
    in-out property <string> a-type: "";
    in-out property <string> a-routes: "—";
    in-out property <string> a-dns: "—";
    in-out property <bool> a-allow-managed: false;
    in-out property <bool> a-allow-global: false;
    in-out property <bool> a-allow-default: false;
    in-out property <bool> a-allow-dns: false;

    callback request-close();
    callback copy-address(string);
    callback advanced-flags-changed();

    VerticalBox {
        padding: Tokens.sp-4;
        spacing: Tokens.sp-3;

        Text {
            text: root.a-name;
            font-size: Tokens.font-title;
            font-weight: 700;
        }
        Text {
            text: root.a-state-emoji + " " + root.a-state-label;
            font-size: Tokens.font-small;
        }

        Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.1); }

        ScrollView {
            height: 420px;
            viewport-width: Tokens.win-w - 2 * Tokens.sp-4;

            VerticalBox {
                spacing: Tokens.sp-2;

                Text { text: "Network ID"; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                Text { text: root.a-nwid; font-size: Tokens.font-small; }

                Text { text: "Your Address"; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                HorizontalLayout {
                    padding: 0;
                    Text { text: root.a-address; font-size: Tokens.font-small; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Copy";
                        min-height: Tokens.ctrl-h;
                        min-width: Tokens.btn-sm-w;
                        clicked => { root.copy-address(root.a-address); }
                    }
                }

                Rectangle { height: Tokens.sp-2; }
                Text {
                    text: "CONNECTION";
                    font-size: Tokens.font-caption;
                    font-weight: 700;
                    color: Palette.foreground.with-alpha(0.45);
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Device"; vertical-alignment: center; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                    Text { text: root.a-device; horizontal-stretch: 1; horizontal-alignment: right; font-size: Tokens.font-secondary; }
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Type"; vertical-alignment: center; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                    Text { text: root.a-type; horizontal-stretch: 1; horizontal-alignment: right; font-size: Tokens.font-secondary; }
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Ethernet"; vertical-alignment: center; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); }
                    Text { text: root.a-mac; horizontal-stretch: 1; horizontal-alignment: right; font-size: Tokens.font-secondary; }
                }

                Rectangle { height: Tokens.sp-2; }
                Text {
                    text: "ADVANCED";
                    font-size: Tokens.font-caption;
                    font-weight: 700;
                    color: Palette.foreground.with-alpha(0.45);
                }
                Text { text: "Managed Addresses"; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                Text { text: root.a-address == "" ? "—" : root.a-address; font-size: Tokens.font-secondary; }
                Text { text: "Managed Routes"; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                HorizontalLayout {
                    padding: 0;
                    Text { text: root.a-routes; font-size: Tokens.font-secondary; vertical-alignment: center; wrap: word-wrap; }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Copy";
                        min-height: Tokens.ctrl-h;
                        min-width: Tokens.btn-sm-w;
                        clicked => { root.copy-address(root.a-routes); }
                    }
                }
                Text { text: "DNS Configuration"; font-size: Tokens.font-caption; color: Palette.foreground.with-alpha(0.55); }
                Text { text: root.a-dns; font-size: Tokens.font-secondary; }

                CheckBox {
                    text: "Network-managed addressing";
                    checked <=> root.a-allow-managed;
                    toggled => { root.advanced-flags-changed(); }
                }
                CheckBox {
                    text: "Allow global addresses";
                    checked <=> root.a-allow-global;
                    toggled => { root.advanced-flags-changed(); }
                }
                CheckBox {
                    text: "Use network as default route";
                    checked <=> root.a-allow-default;
                    toggled => { root.advanced-flags-changed(); }
                }
                CheckBox {
                    text: "Use network DNS";
                    checked <=> root.a-allow-dns;
                    toggled => { root.advanced-flags-changed(); }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                min-height: Tokens.ctrl-h;
                min-width: Tokens.btn-min-w;
                clicked => { root.request-close(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Preferences with side navigation (spec §6.6).
// Pages: General · Notifications · Advanced · About. (Networks has its own
// window; the spec's IA is preserved without duplicating it here.)
// ---------------------------------------------------------------------------
component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: Tokens.nav-height;
    border-radius: Tokens.radius-sm;
    background: root.selected ? Palette.alternate-background : (ta.has-hover ? Palette.alternate-background.with-alpha(0.5) : transparent);

    ta := TouchArea {
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: Tokens.sp-3;
        padding-right: Tokens.sp-3;
        spacing: Tokens.sp-2;
        Text {
            text: root.icon;
            font-size: Tokens.font-body;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: Tokens.font-small;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
}

export component PreferencesWindow inherits Window {
    title: "Preferences";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-prefs-h;

    // 0 General · 1 Notifications · 2 Advanced · 3 Diagnostics · 4 About
    in-out property <int> current-page: 0;

    in-out property <bool> p-start-with-system;
    in-out property <bool> p-start-background;
    in-out property <bool> p-show-tray;
    in-out property <bool> p-notify-status;
    in-out property <string> adv-endpoint: "…";
    in-out property <string> adv-service: "…";
    in-out property <string> about-version: "";
    in-out property <string> about-node-id: "";
    in-out property <[PeerInfo]> diag-peers;

    callback prefs-changed();
    callback request-close();

    HorizontalLayout {
        padding: Tokens.sp-3;
        spacing: Tokens.sp-3;

        // --- side navigation ---
        VerticalLayout {
            width: Tokens.nav-width;
            spacing: Tokens.sp-1;
            NavRow { icon: "⚙"; label: "General"; selected: root.current-page == 0; activated => { root.current-page = 0; } }
            NavRow { icon: "🔔"; label: "Notifications"; selected: root.current-page == 1; activated => { root.current-page = 1; } }
            NavRow { icon: "🛠"; label: "Advanced"; selected: root.current-page == 2; activated => { root.current-page = 2; } }
            NavRow { icon: "📊"; label: "Diagnostics"; selected: root.current-page == 3; activated => { root.current-page = 3; } }
            NavRow { icon: "ℹ"; label: "About"; selected: root.current-page == 4; activated => { root.current-page = 4; } }
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle {
            width: 1px;
            background: Palette.foreground.with-alpha(0.1);
        }

        // --- page content ---
        VerticalLayout {
            spacing: Tokens.sp-3;

            if root.current-page == 0 : VerticalLayout {
                spacing: Tokens.sp-3;
                Text {
                    text: "General";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                }
                CheckBox {
                    text: "Start with system";
                    checked <=> root.p-start-with-system;
                    toggled => { root.prefs-changed(); }
                }
                CheckBox {
                    text: "Start in background";
                    checked <=> root.p-start-background;
                    toggled => { root.prefs-changed(); }
                }
                CheckBox {
                    text: "Show tray icon";
                    checked <=> root.p-show-tray;
                    toggled => { root.prefs-changed(); }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.current-page == 1 : VerticalLayout {
                spacing: Tokens.sp-3;
                Text {
                    text: "Notifications";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                }
                CheckBox {
                    text: "Connection status notifications";
                    checked <=> root.p-notify-status;
                    toggled => { root.prefs-changed(); }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.current-page == 2 : VerticalLayout {
                spacing: Tokens.sp-3;
                Text {
                    text: "Advanced";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Daemon endpoint"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.adv-endpoint; font-size: Tokens.font-secondary; vertical-alignment: center; }
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Service"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.adv-service; font-size: Tokens.font-secondary; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.current-page == 3 : VerticalLayout {
                spacing: Tokens.sp-2;
                Text {
                    text: "Diagnostics";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Daemon"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.adv-endpoint; font-size: Tokens.font-secondary; vertical-alignment: center; }
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Service"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.adv-service; font-size: Tokens.font-secondary; vertical-alignment: center; }
                }
                HorizontalLayout {
                    padding: 0;
                    Text { text: "Node"; font-size: Tokens.font-secondary; color: Palette.foreground.with-alpha(0.55); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.about-node-id; font-size: Tokens.font-secondary; vertical-alignment: center; }
                }
                Text {
                    text: "Peers";
                    font-size: Tokens.font-body;
                    font-weight: 600;
                }
                if root.diag-peers.length == 0 : SecondaryText {
                    text: "No peers connected";
                    font-size: Tokens.font-secondary;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Tokens.sp-1;
                        for p[i] in root.diag-peers : HorizontalLayout {
                            padding: 0;
                            spacing: Tokens.sp-2;
                            Text {
                                text: (p.active ? "● " : "○ ") + p.address;
                                font-size: Tokens.font-secondary;
                                vertical-alignment: center;
                                color: p.active ? Palette.foreground : Palette.foreground.with-alpha(0.5);
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: p.role;
                                font-size: Tokens.font-caption;
                                color: Palette.foreground.with-alpha(0.55);
                                vertical-alignment: center;
                            }
                            Text {
                                text: p.latency;
                                font-size: Tokens.font-secondary;
                                vertical-alignment: center;
                                color: Palette.foreground.with-alpha(0.75);
                            }
                        }
                    }
                }
            }

            if root.current-page == 4 : VerticalLayout {
                spacing: Tokens.sp-2;
                Text {
                    text: "About";
                    font-size: Tokens.font-section;
                    font-weight: 700;
                }
                Text { text: "ZGALAXY Desktop Client"; font-size: Tokens.font-body; font-weight: 600; }
                SecondaryText { text: "Version " + root.about-version; font-size: Tokens.font-secondary; }
                Text { text: "Node ID: " + root.about-node-id; font-size: Tokens.font-secondary; }
                SecondaryText { text: "AGPL-3.0-or-later"; font-size: Tokens.font-caption; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        min-height: Tokens.ctrl-h;
                        min-width: Tokens.btn-min-w;
                        clicked => { root.request-close(); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// About window (tray entry point, spec §9.3)
// ---------------------------------------------------------------------------
export component AboutWindow inherits Window {
    title: "About";
    icon: @image-url("assets/app-icon-gold.png");
    width: Tokens.win-w;
    height: Tokens.win-about-h;

    in-out property <string> about-version: "";
    in-out property <string> about-node-id: "";

    callback request-close();

    VerticalBox {
        padding: Tokens.sp-4;
        spacing: Tokens.sp-2;
        alignment: center;

        Image {
            source: @image-url("assets/app-icon-gold.png");
            width: 64px;
            height: 64px;
            horizontal-alignment: center;
        }
        Text {
            text: "ZGALAXY";
            font-size: 26px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        SecondaryText {
            text: "Desktop client · v" + root.about-version;
            font-size: Tokens.font-secondary;
            horizontal-alignment: center;
        }
        Text {
            text: "Node ID: " + root.about-node-id;
            font-size: Tokens.font-secondary;
            horizontal-alignment: center;
        }
        SecondaryText {
            text: "AGPL-3.0-or-later";
            font-size: Tokens.font-caption;
            horizontal-alignment: center;
        }
        Button {
            text: "Close";
            min-height: Tokens.ctrl-h;
            min-width: Tokens.btn-min-w;
            clicked => { root.request-close(); }
        }
    }
}
